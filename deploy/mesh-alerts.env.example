# Opcional: estas variáveis sobrescrevem valores de config.yaml no serviço systemd.
# Edite config.yaml para a configuração normal. Use caminhos absolutos no systemd.
# MESH_ALERTS_TCP_HOST=meshtastic-node.local
# MESH_ALERTS_TCP_PORT=4403
# MESH_ALERTS_CHANNEL_INDEX=0
# MESH_ALERTS_DESTINATION=^all
# MESH_ALERTS_DATABASE=/var/lib/mesh-alerts/alerts.sqlite3
# MESH_ALERTS_OUTPUT_DIR=/var/lib/mesh-alerts/output
# MESH_ALERTS_INTERVAL=60
