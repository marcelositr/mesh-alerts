# Optional overrides for the CAP service systemd unit.
# The state directory is writable under /var/lib/mesh-alerts.
MESH_ALERTS_DATABASE=/var/lib/mesh-alerts/alerts.sqlite3
MESH_ALERTS_OUTPUT_DIR=/var/lib/mesh-alerts/output

# Uncomment to override the values in config.yaml.
# MESH_ALERTS_TCP_HOST=meshtastic-node.local
# MESH_ALERTS_TCP_PORT=4403
# MESH_ALERTS_CHANNEL_INDEX=2  # canal CAP; padrão definido em config.yaml
# MESH_ALERTS_DESTINATION=^all
# MESH_ALERTS_INTERVAL=60
